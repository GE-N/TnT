{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TnT Flow Draft v1 — proposed contract",
  "description": "Schema validation is necessary but not sufficient; see ai-flow-authoring-contract-v1.md for normative semantic rules.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "const": "createScenario"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "appId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setup": {
          "$ref": "#/$defs/setup"
        },
        "handlerRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 20
        },
        "mock": {
          "$ref": "#/$defs/mock"
        }
      },
      "required": [
        "setup",
        "handlerRefs",
        "mock"
      ]
    },
    "screens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screen"
      },
      "minItems": 1,
      "maxItems": 80
    },
    "visits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/visit"
      },
      "minItems": 1,
      "maxItems": 81
    },
    "scripts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/script"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      },
      "minItems": 0,
      "maxItems": 50
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "name",
    "appId",
    "parameters",
    "execution",
    "screens",
    "visits",
    "scripts",
    "assumptions"
  ],
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "enum": [
            "text",
            "id"
          ]
        },
        "match": {
          "enum": [
            "exact",
            "contains",
            "regex"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "target",
        "match",
        "value"
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "context"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "ref"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "selector"
            },
            "selector": {
              "$ref": "#/$defs/selector"
            }
          },
          "required": [
            "kind",
            "selector"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unresolved"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "kind",
            "description"
          ]
        }
      ]
    },
    "screen": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "kind": {
              "const": "create"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "key",
            "kind",
            "title"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "kind": {
              "const": "existing"
            },
            "screenId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "key",
            "kind",
            "screenId"
          ]
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "literal"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "parameter"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unresolved"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "kind",
            "description"
          ]
        }
      ]
    },
    "destination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "stay"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "visit"
            },
            "visitKey": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          },
          "required": [
            "kind",
            "visitKey"
          ]
        }
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "kind": {
              "const": "tap"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "destination": {
              "$ref": "#/$defs/destination"
            }
          },
          "required": [
            "key",
            "kind",
            "target",
            "destination"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "kind": {
              "const": "back"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "destination": {
              "$ref": "#/$defs/destination"
            }
          },
          "required": [
            "key",
            "kind",
            "target",
            "destination"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "kind": {
              "const": "input"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "key",
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "kind": {
              "const": "checkVisible"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          },
          "required": [
            "key",
            "kind",
            "target"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "kind": {
              "const": "checkAbsent"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          },
          "required": [
            "key",
            "kind",
            "target"
          ]
        }
      ]
    },
    "visit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "screenKey": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "key",
        "screenKey",
        "operations"
      ]
    },
    "placement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "beforeOperation"
            },
            "visitKey": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "operationKey": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          },
          "required": [
            "kind",
            "visitKey",
            "operationKey"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "scenarioEnd"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "language": {
          "const": "maestro-javascript"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64000
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parameters": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              "minItems": 0,
              "maxItems": 20
            },
            "mockSession": {
              "type": "boolean"
            }
          },
          "required": [
            "parameters",
            "mockSession"
          ]
        }
      },
      "required": [
        "key",
        "label",
        "language",
        "source",
        "placement",
        "requires"
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "type": {
          "enum": [
            "text",
            "number",
            "boolean"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "type",
        "required"
      ]
    },
    "setup": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "launchApp"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "context"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "ref"
          ]
        }
      ]
    },
    "mock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "context"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "ref"
          ]
        }
      ]
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "about": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "requiresConfirmation": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "message",
        "about",
        "requiresConfirmation"
      ]
    }
  }
}
