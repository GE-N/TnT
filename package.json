    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^29.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "overrides": {
    "@faker-js/faker": "10.6.0"
